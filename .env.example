# Server-side only. Never exposed to the client.
ANTHROPIC_API_KEY=

# Optional override for the model used by /api/parse.
# SHORTORDER_MODEL=claude-sonnet-4-6

# Optional: Vercel Blob token for durable ephemeral .shortcut hosting.
# Without it, shortcuts are held in process memory with a TTL (fine for
# local dev and single-instance deploys; not for multi-instance serverless).
# BLOB_READ_WRITE_TOKEN=

# Optional: force the public origin used in shortcuts://import-shortcut URLs.
# Defaults to the request origin. Must be publicly reachable by Apple devices.
# PUBLIC_BASE_URL=https://shortorder.example.com
